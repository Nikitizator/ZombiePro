; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="zombiePro 1.0"
run/main_scene="uid://cgvdwjodqslq"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/stretch_mode=0
boot_splash/use_filter=false
boot_splash/image="uid://bys0o5o4134gw"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=1000

[autoload]

Global="*uid://l0fir1lbcv4f"

[display]

window/size/viewport_width=1024
window/size/viewport_height=1024
window/size/window_width_override=1024
window/size/window_height_override=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"

[physics]

